# 이 파일을 복사해 .env를 만들고 값을 채우세요: cp .env.example .env
# .env는 .gitignore에 포함되어 커밋되지 않습니다 — 개인 설정이니 자유롭게 채워도 됩니다.
# 모든 항목은 비워둬도 동작합니다 (해당 조건을 검사하지 않거나 기본값이 적용됨).

# ── 공고 필터 ──────────────────────────────────────────────────────────────
# 제목/직무 태그에 하나라도 포함되면 통과 (쉼표로 구분, 비워두면 전체허용)
FILTER_KEYWORDS=

# 근무 지역 (쉼표로 구분, 비워두면 전체허용)
# 원티드 API는 "판교"·"성남" 같은 시/군/구 단위 지역 정보를 제공하지 않고 "경기"처럼
# 시/도 단위로만 준다. 판교/성남 지역의 원티드 공고까지 잡으려면 "경기"를 함께 넣어야 한다
# (사람인은 시/군/구 단위라 "경기"를 넣으면 판교/성남 외 경기 전역 공고도 함께 통과됨)
FILTER_LOCATIONS=

# 경력 구분: 신입 / 경력 / 신입·경력 (쉼표로 여러 개 선택 가능, 예: "신입, 경력무관") / 비워두면 전체허용
FILTER_CAREER_TYPE=

# 경력 연차 범위 (비워두면 해당 방향 제한없음)
FILTER_EXP_MIN=
FILTER_EXP_MAX=

# 채용공고가 아닌 것으로 간주해 제외할 단어 (쉼표로 구분)
# FILTER_KEYWORDS가 제목이 아닌 직무 태그에만 걸린 경우에 한해 검사한다
FILTER_EXCLUDE_KEYWORDS=교육생, 무료교육, 설명회, 상시채용

# 지원하고 싶지 않은 회사명 (쉼표로 구분, 회사명에 부분 포함되면 제외, 비워두면 전체허용)
FILTER_EXCLUDE_COMPANIES=

# ── 관련성 랭킹 ────────────────────────────────────────────────────────────
# FILTER_KEYWORDS를 통과한 공고를 대상으로, 로컬 임베딩 모델(비용 없음, API 호출 아님)로
# "직무"와 "도메인"을 따로 비교해 관련성 순위를 매기고 상위 top_n건만 남긴다.
# 둘 다 비워두면 이 단계를 건너뛴다. 예: roles=기획, PM / domains=커머스, 게임
#   → 직무·도메인 둘 다 가까운 "게임 기획 PM"이 1순위,
#     하나만 가까운 "반도체 개발 PM"·"게임 마케팅팀"이 그 다음 순위로 정렬된다.
RELEVANCE_ROLES=
RELEVANCE_DOMAINS=

# 상위 몇 건만 jobs_all.txt에 남길지. 순위 밖으로 밀린 공고는 영구 제외되지 않고
# 다음 수집 때 경쟁 구도가 바뀌면 다시 상위권에 들 수 있다.
RELEVANCE_TOP_N=20

# 한국어 문장 임베딩 모델 (최초 실행 시 자동 다운로드)
RELEVANCE_MODEL=snunlp/KR-SBERT-V40K-klueNLI-augSTS

# ── 자소서 파이프라인 AI Provider ─────────────────────────────────────────
# 계획/계획평가/작성/초안평가 역할마다 아래 중 하나를 선택 (역할별로 다르게 섞어도 됨):
#   claude_cli | codex_cli | api:anthropic | api:openai
# claude_cli / codex_cli: 이미 로그인된 CLI 세션을 그대로 사용 (API 키 불필요)
# api:anthropic / api:openai: 아래 API 키로 직접 호출 (호출당 별도 과금 발생)
PROVIDER_PLANNER=claude_cli
PROVIDER_PLAN_EVALUATOR=claude_cli
PROVIDER_WRITER=claude_cli
PROVIDER_DRAFT_EVALUATOR=claude_cli
# evaluate로 추린 공고의 실제 상세 요건(사람인은 이미지, 원티드는 텍스트)을 지원자 프로필과
# 대조해 검수한다 (jobfind.py verify). 이미지를 읽어야 하므로 비전을 지원하는 provider 필요.
PROVIDER_VERIFIER=claude_cli

# ── API 키 (선택) ──────────────────────────────────────────────────────────
# 위에서 api:anthropic / api:openai를 선택했을 때만 필요
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# DART(전자공시시스템) 오픈API 키 — 있으면 자소서 계획 단계에서 상장기업 개황(대표자·
# 설립일·시장구분·홈페이지)을 자동으로 가져와 반영한다. 없어도 나머지는 정상 동작하며,
# 애초에 비상장 회사는 DART에 없어서 이 기능이 적용되지 않는다.
# 무료, 가입 즉시 발급: https://opendart.fss.or.kr (인증키 신청/관리)
DART_API_KEY=

# 사람인 공식 API 승인을 받으면 여기에 키를 추가 (현재는 스크래핑 방식이라 필수 아님)
SARAMIN_ACCESS_KEY=
